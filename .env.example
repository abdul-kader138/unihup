APP_NAME="UniHup"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# A hobby/small-scale app — database-backed session/cache/queue need no
# extra infrastructure to run. Switch to redis (and set REDIS_* below) if
# you outgrow this.
# For production with Redis, set SESSION_DRIVER=redis.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# 'null' = no realtime; Support Chat and the WhatsApp Inbox fall back to
# short-interval polling. Set to 'reverb' and fill the REVERB_* block near the
# bottom of this file (after `composer require laravel/reverb`, already done
# here) to make chat instant over WebSockets.
BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
# For production with Redis, set QUEUE_CONNECTION=redis.
QUEUE_CONNECTION=database

# For production with Redis, set CACHE_STORE=redis.
CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Default super_admin seeded by ShieldSeeder — this account gets full access
# to the University/Subject/DegreeProgram admin pages.
ADMIN_FIRST_NAME=Super
ADMIN_LAST_NAME=Admin
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=password

# "Sign in with Google" — leave blank to hide the button.
# Create credentials at https://console.cloud.google.com/apis/credentials
# and set the authorized redirect URI to GOOGLE_REDIRECT_URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# WhatsApp Business Cloud API — student <-> staff support chat.
# Leave PHONE_NUMBER_ID / ACCESS_TOKEN blank to disable the feature.
# Set up at https://developers.facebook.com → your app → WhatsApp.
# Webhook callback URL: ${APP_URL}/webhooks/whatsapp  (verify token = below)
WHATSAPP_API_VERSION=v22.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_REOPEN_TEMPLATE=support_reply_reopen
WHATSAPP_REOPEN_TEMPLATE_LANGUAGE=en

# ── Realtime chat (Laravel Reverb) ───────────────────────────────────────────
# Leave BROADCAST_CONNECTION=null (above) to skip realtime — chat still works
# via polling. To turn it on:
#   1. set BROADCAST_CONNECTION=reverb (above)
#   2. fill REVERB_APP_ID / KEY / SECRET (php artisan reverb:install generates
#      them into .env directly — re-run it, or copy the values it wrote)
#   3. deploy.sh installs the unihup-reverb systemd service automatically
#   4. add the /app WebSocket proxy to your nginx site (see deploy notes)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# PHP -> Reverb: a direct loopback hop on the box. Leave as localhost even in
# production — do NOT point this at your public domain.
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

# Browser -> Reverb: the public address, served through the nginx /app proxy.
REVERB_PUBLIC_HOST=unihup.example.com
REVERB_PUBLIC_PORT=443
REVERB_PUBLIC_SCHEME=https

# What the Reverb process itself binds to (matches deploy/unihup-reverb.service).
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
