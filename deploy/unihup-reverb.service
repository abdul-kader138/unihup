[Unit]
Description=UniHup Reverb WebSocket server (php artisan reverb:start)
After=network.target mysql.service

[Service]
Type=simple
# Matches deploy.sh's WEB_USER/APP_DIR defaults — installed as-is, not
# templated. If those are overridden for a deployment, update the three
# paths below to match.
User=www-data
Group=www-data
WorkingDirectory=/var/www/unihup
# Binds to loopback only — nginx terminates TLS and proxies /app (the
# Reverb path) through to this port. Keep --host/--port in sync with the
# REVERB_HOST/REVERB_PORT the PHP side broadcasts with (see .env) and with
# the nginx proxy_pass target.
ExecStart=/usr/bin/php /var/www/unihup/artisan reverb:start --host=127.0.0.1 --port=8080
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
